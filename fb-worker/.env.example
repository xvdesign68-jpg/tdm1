# ==== SmartLead FB Worker — cấu hình (copy sang .env rồi sửa) ====
# Anh chỉnh thoải mái để "set đa dạng" theo ý — tất cả đều có mặc định an toàn.

# --- AdsPower Local API ---
# Bật trong AdsPower: Setting → Local API → Enable. Mặc định cổng 50325.
# Trên VPS Windows chạy AdsPower thì để nguyên. Nếu worker chạy máy khác thì thay bằng http://<ip-vps>:50325
ADSPOWER_API=http://local.adspower.net:50325
# AdsPower giới hạn 1 request/giây cho Local API — worker tự giãn, đừng chỉnh thấp hơn 1000ms.
ADSPOWER_MIN_REQ_GAP_MS=1100
# Mở trình duyệt dạng headless (1) hay hiện cửa sổ (0). Windows-desktop nên để 0; Linux headless để 1 (cần xvfb — xem README).
ADSPOWER_HEADLESS=0
# Tham số mở thêm cho Chrome của AdsPower (giữ trống nếu không cần)
ADSPOWER_LAUNCH_ARGS=

# --- Nhịp người thật (chống ban theo hành vi) ---
ACTION_MIN_DELAY_MS=1400          # nghỉ tối thiểu giữa các thao tác nhỏ
ACTION_MAX_DELAY_MS=4200          # nghỉ tối đa
TYPE_MIN_MS=45                    # tốc độ gõ/ký tự (nhanh nhất)
TYPE_MAX_MS=155                   # tốc độ gõ/ký tự (chậm nhất)

# --- Van an toàn theo TỪNG nick/profile/ngày ---
DAILY_CAP_REACT=80
DAILY_CAP_COMMENT=25
DAILY_CAP_INBOX=15                # inbox người lạ = rủi ro cao nhất → để THẤP
MIN_GAP_SEC=45                    # khoảng cách tối thiểu giữa 2 thao tác cùng 1 nick
ACTIVE_HOURS=8-22                 # chỉ chạy trong khung giờ này (giờ máy VPS). Để 0-24 nếu muốn tắt.
STATE_FILE=./state.json           # nơi lưu bộ đếm ngày (đừng xoá)

# --- Ngôn ngữ FB của nick (để chọn đúng nhãn nút) ---
# vi = tiếng Việt, en = English. Worker vẫn thử cả 2 nếu không khớp.
LOCALE_HINT=vi

# --- (Tuỳ chọn) Chế độ WORKER đọc hàng đợi Firestore ---
# Chỉ cần khi chạy worker.js. Bỏ qua nếu chỉ test bằng test.js.
# Đường dẫn file service account JSON của Firebase (KHÔNG commit file này lên git).
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_COLLECTION=outreach_tasks
WORKER_POLL_MS=5000               # nhịp hỏi hàng đợi
WORKER_BATCH=5                    # số task lấy mỗi vòng
